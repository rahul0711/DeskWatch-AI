<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appFooterRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_footer_designed_by"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/footerLogo"
        android:layout_width="45dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/app_footer_script_india"
        android:scaleType="fitCenter"
        android:src="@drawable/scriptindia" />



</LinearLayout>
